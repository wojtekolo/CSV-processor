<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@mainStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.wojtekolo.studia.app.MainController">
   <children>
      <BorderPane layoutX="29.0" layoutY="23.0" prefHeight="419.0">
         <center>
            <HBox BorderPane.alignment="CENTER">
               <children>
                  <TableView fx:id="tablePaths">
                    <columns>
                      <TableColumn fx:id="colPaths" minWidth="500.0" prefWidth="-1.0" text="Ścieżka" />
                    </columns>
                  </TableView>
                  <TableView fx:id="tableColumns">
                    <columns>
                      <TableColumn fx:id="colColumns" minWidth="250.0" prefWidth="-1.0" text="Kolumny do zostawienia" />
                    </columns>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </TableView>
               </children>
            </HBox>
         </center>
         <top>
            <HBox prefHeight="52.0" prefWidth="338.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="btnFile" mnemonicParsing="false" onAction="#addFiles" styleClass="btn-green" text="Wybierz pliki CSV do złączenia" />
                  <Button fx:id="btnResetFiles" mnemonicParsing="false" onAction="#resetFiles" styleClass="btn-red" text="Reset plikow">
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnAddColumn" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#addColumn" styleClass="btn-green" text="Dodaj kolumnę:">
                     <HBox.margin>
                        <Insets left="30.0" />
                     </HBox.margin>
                  </Button>
                  <TextField fx:id="tfColumn" promptText="Wpisz nazwę kolumny" styleClass="card">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </TextField>
                  <Button fx:id="btnResetColumns" layoutX="133.0" layoutY="10.0" mnemonicParsing="false" onAction="#resetColumns" styleClass="btn-red" text="Reset kolumn">
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </top>
         <bottom>
            <HBox BorderPane.alignment="CENTER">
               <children>
                  <ComboBox fx:id="cbProcessor" minWidth="300.0" promptText="Wybierz akcję" styleClass="card">
                     <HBox.margin>
                        <Insets top="10.0" />
                     </HBox.margin>
                  </ComboBox>
                  <Button fx:id="btnAction" mnemonicParsing="false" onAction="#submitTask" styleClass="btn-outline" text="Wykonaj akcję">
                     <HBox.margin>
                        <Insets bottom="10.0" left="20.0" top="10.0" />
                     </HBox.margin></Button>
                  <ProgressBar fx:id="pbProgress" minWidth="340.0" progress="0.0" styleClass="card">
                     <HBox.margin>
                        <Insets left="10.0" top="14.0" />
                     </HBox.margin>
                  </ProgressBar>
               </children>
            </HBox>
         </bottom>
         <right>
            <VBox BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets left="20.0" />
               </BorderPane.margin>
            </VBox>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
